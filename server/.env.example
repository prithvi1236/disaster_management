# Database Configuration
DATABASE_URL=sqlite:///./disaster_management.db
TEST_DATABASE_URL=sqlite:///./test_disaster_management.db

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-make-it-long-and-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# CORS Settings (add your frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173